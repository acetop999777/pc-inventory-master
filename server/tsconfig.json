{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "errors/**/*.js",
    "errors/**/*.ts",
    "errors/**/*.d.ts",
    "validators/**/*.js",
    "validators/**/*.ts",
    "validators/**/*.d.ts",
    "repositories/**/*.js",
    "repositories/**/*.ts",
    "repositories/**/*.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
